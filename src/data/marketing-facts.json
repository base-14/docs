      "startupAuthorizedUsers": 50,
      "defaultRetentionDays": 30
    },
    "newRelic": {
      "fullPlatformPerUser": 349,
      "corePerUser": 49,
      "dataIngestPerGb": 0.4,
      "dataPlusPerGb": 0.6,
      "freeIngestGb": 100,
      "defaultRetentionDays": 8
    },
    "datadog": {
      "infraPerHost": 23,
      "apmPerHost": 31,
      "logIngestPerGb": 0.1,
