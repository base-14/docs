  "consistency": [
    {
      "label": "New Relic per-user rates",
      "pattern": "\\$(\\d+)(?:\\.\\d+)?/user",
      "allowed": [349, 49, 99],
      "note": "Full Platform is $349, Core $49, Standard additional users $99."
    },
    {
      "label": "Scout metrics rate",
      "pattern": "\\$(\\d+\\.\\d+)/M metrics",
      "allowed": [0.1]
    },
    {
      "label": "Scout logs and traces rate",
      "pattern": "\\$(\\d+\\.\\d+)/M logs",
      "allowed": [0.25]
    },
    {
      "label": "Scout platform fee",
      "pattern": "\\$(\\d+)/month platform fee",
      "allowed": [250]
    },
    {
      "label": "Startup authorized user cap",
      "pattern": "up to (\\d+) authorized users",
      "allowed": [50]
    },
    {
      "label": "Datadog per-host rates",
      "pattern": "\\$(\\d+)/host",
      "allowed": [23, 31],
      "note": "Infrastructure Pro is $23/host, APM Pro $31/host, both annual billing."
    },
    {
      "label": "Datadog custom metric rate",
      "pattern": "\\$1 per (\\d+) custom metrics",
      "allowed": [100]
    }
  ],

  "forbidden": [
    {
      "pattern": "unlimited users?",
      "reason": "Scout has no per-seat charge, but the Startup tier caps authorized users at 50. Say 'no per-seat charges' and name the cap."
    },
    {
      "pattern": "(doesn't|does not) cover (frontend )?RUM",
      "reason": "Scout RUM ships for web and mobile. The real gap is session replay and profiling."
    },
    {
      "pattern": "no (frontend |browser |mobile )?(RUM|real.user monitoring)",
      "reason": "Scout RUM ships for web and mobile. The real gap is session replay and profiling."
    },
    {
      "pattern": "permanent (negotiating power|portability)",
      "reason": "Overclaim. Say what portability does: instrumentation works with any OTel-compatible backend."
    },
    {
      "pattern": "[\\u2013\\u2014]",
      "reason": "House style is hyphens. No en or em dashes in prose."
    },
    {
      "pattern": "Risk: None",
      "reason": "Switching platforms carries migration effort. Name it."
    }
  ],

  "requiredCasing": {
    "pattern": "^(?:title: \"|# )(.+?)\"?$",
    "note": "Frontmatter titles and H1s use sentence case across the marketing pages.",
    "titleCaseThreshold": 0.6,
    "alwaysCapitalized": [
      "AWS", "APM", "AI", "ANR", "ANRs", "Azure", "BYOC", "CloudWatch", "CNCF",
      "Core", "CPU", "Datadog", "GB", "GCP", "Grafana", "I", "IAM", "ISO", "K8s",
      "Kubernetes", "LLM", "MTTR", "New", "NRQL", "OTLP", "OTel", "OpenTelemetry",
      "PoC", "RUM", "Relic", "SDK", "SDKs", "SLA", "SOC", "SQL", "SRE", "SREs",
      "Scout", "TCO", "TL;DR", "Web", "X-Ray", "base14"
    ]
  }
}
